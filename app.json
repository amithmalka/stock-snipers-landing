{
  "expo": {
    "name": "siel-app",
    "slug": "siel-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.siel-app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.siel.app",
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "SIEL",
      "shortName": "SIEL",
      "description": "אפליקציה לניהול וסת, טבילה ותפילה",
      "themeColor": "#C4849A",
      "backgroundColor": "#FDF8F5",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "he",
      "dir": "rtl"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C4849A",
          "defaultChannel": "siel-default",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3b83ef35-bdd2-4549-a057-f2a5e5cd8a1b"
      }
    }
  }
}
